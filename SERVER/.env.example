# ---------------------------------------------------------------------------
# ETMW Radio AI — server environment
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4330
HOST=127.0.0.1
PUBLIC_BASE_URL=https://entertomyworld.com/apps/radio-ai
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://entertomyworld.com,https://www.entertomyworld.com
TRUST_PROXY=loopback

# MongoDB
MONGO_URI=
MONGO_DB_NAME=etmw_radio_ai

# JWT (30-day email-code sessions)
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Zoho SMTP
SMTP_HOST=smtppro.zoho.eu
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@entertomyworld.com
SMTP_PASS=
SMTP_FROM=info@entertomyworld.com
SMTP_FROM_NAME=ETMW Radio AI
ADMIN_EMAIL=warodri@gmail.com
# Emails that get administrator access after signing in (JSON array).
# Add more like: ADMIN_EMAILS=["warodri@gmail.com","someone@example.com"]
ADMIN_EMAILS=["warodri@gmail.com"]

# Login-code behaviour
AUTH_CODE_TTL_MINUTES=10
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_RATE_EMAIL_MAX=5
AUTH_CODE_RATE_IP_MAX=20
AUTH_CODE_RATE_WINDOW_MINUTES=60
# Development only: include the code in the API response (ignored in production).
AUTH_DEV_RETURN_CODE=false

# ETMW Songs integration (song creation is delegated to the songs project)
SONGS_API_URL=https://entertomyworld.com/apps/songs/api
SONGS_API_KEY=
SONGS_API_TIMEOUT_MS=30000
CREATOR_MAX_DURATION_SECONDS=240

# OpenAI host avatar generation
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_TIMEOUT_MS=180000

# Ollama / Phonon host voices
OLLAMA_BASE_URL=https://ollama--warodri.entertomyworld.com
PHONON_MODEL=phonon
PHONON_TIMEOUT_MS=120000

# Text generation, research, and host script TTS
OLLAMA_TEXT_MODEL=qwen3-vl:32b-instruct
OLLAMA_TEXT_TIMEOUT_MS=900000
POIROT_API_URL=https://entertomyworld.com/apps/poirot
POIROT_API_KEY=
POIROT_TIMEOUT_MS=240000
VOICE_STUDIO_API_URL=https://voice-studio--warodri.entertomyworld.com
# VoiceStudio TTS engine: omnivoice (current), kittentts, mlx-audio, etc.
VOICE_STUDIO_ENGINE=omnivoice
# Optional: force one VoiceStudio profile for every host (e.g., a VoiceStudio design voice).
VOICE_STUDIO_PROFILE_OVERRIDE=

VOICE_STUDIO_API_KEY=
VOICE_STUDIO_TIMEOUT_MS=900000
SCRIPT_MAX_WORDS=1300
SCRIPT_MAX_HOSTS=2
SCRIPT_MAX_DURATION_SECONDS=600
