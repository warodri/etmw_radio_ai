{
  "name": "etmw-radio-ai-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ETMW Radio AI API — email-code authentication for the radio-ai client.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run typecheck && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.0.0",
    "nodemailer": "^10.2.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
